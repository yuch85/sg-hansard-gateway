# Hansard Gateway environment variables (Phase 27.2, 27.2-REQ-02).
#
# Every deployment-relevant Settings field is overridable by one of these
# HANSARD_* vars (hydrated at config.py import — src/hansard_gateway/
# config.py:_env_settings). Each line documents BOTH the code default and
# the container default baked into the Dockerfile. Copy to .env (gitignored)
# or pass via your orchestrator; keep this file sourceable.

# Bind port. Code default: 8765. Container default: 8000 (Dockerfile ENV).
HANSARD_APP_PORT=8000

# Term index DB location. Code default: ~/.hansard/index.db. Container
# default: /data/index.db — mount a persistent volume at /data.
HANSARD_INDEX_DB_PATH=/data/index.db

# Capability-token store location. Code default: tokens.yaml (repo root).
# Container default: /data/tokens.yaml — generate on the host with
# `uv run hg-tokens generate <label>` and mount it read-only.
HANSARD_TOKENS_PATH=/data/tokens.yaml

# Public origin of THIS deployment. MUST be set to your domain — the code
# default is the live origin and must never ship into a new deployment
# (absolute token-bearing URLs are built from it). Example value:
HANSARD_PUBLIC_BASE_URL=https://hansard.example.org

# Structured request-log file (D-09). Empty = stream only (test default);
# production sets a file. Container example: /data/logs/hansard-gateway.log
# (the app creates the /data/logs/ parent dir itself at boot — no
# pre-creation step anywhere).
HANSARD_LOG_FILE=/data/logs/hansard-gateway.log

# =1: also emit JSON request lines to stderr for container log collection
# (D-09). Set for production.
HANSARD_LOG_STREAM=1

# robots.txt override file (27.2-REQ-05). Optional: unset = the built-in
# 148-byte default body. When set to a path, that file is served verbatim
# (retrieval policy, NOT access control — RFC 9309).
#HANSARD_ROBOTS_PATH=/data/robots.txt
