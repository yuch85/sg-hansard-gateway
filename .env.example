# Hansard Gateway environment variables (Phase 27.2, 27.2-REQ-02).
#
# Every deployment-relevant Settings field is overridable by one of these
# HANSARD_* vars (hydrated at config.py import — src/hansard_gateway/
# config.py:_env_settings). Each line documents BOTH the code default and
# the container default baked into the Dockerfile. Copy to .env (gitignored)
# or pass via your orchestrator; keep this file sourceable.

# Bind port. Code default: 8765. Container default: 8000 (Dockerfile ENV).
# NOTE: this is a HOST-RUN knob only — inside the container the server
# always binds 8000 (the HEALTHCHECK probes hardcoded 127.0.0.1:8000).
# Publish a different host port with `docker run -p 9000:8000`.
HANSARD_APP_PORT=8000

# Term index DB location. Code default: ~/.hansard/index.db. Container
# default: /data/index.db — mount a persistent volume at /data.
HANSARD_INDEX_DB_PATH=/data/index.db

# Capability-token store location. Code default: tokens.yaml (repo root).
# Container default: /data/tokens.yaml — generate on the host with
# `uv run hg-tokens generate <label>` and mount it read-only.
HANSARD_TOKENS_PATH=/data/tokens.yaml

# Public origin of THIS deployment. MUST be set to your domain — the code
# default is the live origin and must never ship into a new deployment
# (absolute token-bearing URLs are built from it). Example value:
HANSARD_PUBLIC_BASE_URL=https://hansard.example.org

# Structured request-log file (D-09). Empty = stream only (test default);
# production sets a file. Container example: /data/logs/hansard-gateway.log
# (the app creates the /data/logs/ parent dir itself at boot — no
# pre-creation step anywhere).
HANSARD_LOG_FILE=/data/logs/hansard-gateway.log

# =1: also emit JSON request lines to stderr for container log collection
# (D-09). Set for production.
HANSARD_LOG_STREAM=1

# robots.txt override file (27.2-REQ-05). Optional: unset = the built-in
# 148-byte default body. When set to a path, that file is served verbatim
# (retrieval policy, NOT access control — RFC 9309).
#HANSARD_ROBOTS_PATH=/data/robots.txt

# --- In-image crawler (Phase 27.5, v0.2.0) ----------------------------------
# Fire-and-forget one-liner:
#   docker run -e HANSARD_CRAWL_ENABLED=1 -v hansard-index:/data <image>
#
# =1 runs the crawl loop next to the server in the same container. Code
# default: 0 (a bare `docker run` never crawls). One writer per /data volume:
# never point two crawl-enabled containers at one volume — the contender
# skips its run (exit 3) while the lock is held.
#HANSARD_CRAWL_ENABLED=0

# Seconds before the entrypoint restarts a crashed crawl loop (the loop
# restart never touches the server process). Entrypoint default: 30 (this
# knob is read by docker-entrypoint.sh, not the Python code). Non-numeric
# or non-positive values are ignored with a warning.
#HANSARD_CRAWL_RESTART_SECONDS=30

# Hours between crawl runs; the first run starts immediately at container
# start. Code default: 24.0. Non-numeric or non-positive values are ignored
# with a warning.
#HANSARD_CRAWL_INTERVAL_HOURS=24

# FIRST-RUN GUARD: on a FRESH /data volume the first crawl fetches only the
# last N days (code default: 31) and records that floor, so a new deployment
# is useful in minutes. Full history from 1955 is ~26k daily requests — many
# hours at ~1 req/s. =1 (or `crawl once --cold`) backfills everything and
# clears the floor.
#HANSARD_CRAWL_FULL_HISTORY=0
#HANSARD_CRAWL_FIRST_RUN_DAYS=31

# Crawl window settings (code defaults shown; overridable since 27.5):
# enumeration floor (Parliament's first sitting era), re-fetch age for
# already-crawled sittings, and the late-posted-reports recheck window
# (0 = never recheck).
#HANSARD_CRAWL_START_DATE=1955-01-01
#HANSARD_CRAWL_RECRAWL_AGE_DAYS=90
#HANSARD_CRAWL_EMPTY_RECHECK_DAYS=14
